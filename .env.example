# This file is a reference. The application does NOT automatically load .env.
# Use your process manager/secret manager or export individual variables.
APP_ENV=local
APP_DATABASE_DRIVER=memory
# APP_LOGGING_FORMAT=console # json (deployment default), text or console
# APP_LOGGING_COLOR=auto # console only: auto or never; NO_COLOR also disables color
# NO_COLOR=1
# APP_DATABASE_DSN=postgres://app:password@localhost:5432/app?sslmode=disable
# APP_AUTH_API_KEYS=[{"id":"service-a","sha256":"<64 hex characters>","subject":"service-a","scopes":["users:read","users:write"]}]
# APP_AUTH_JWT_ENABLED=true
# APP_AUTH_JWT_ISSUER=https://identity.example.com/
# APP_AUTH_JWT_AUDIENCE=microservice
# APP_AUTH_JWT_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# APP_FLAGS_PROVIDER=launchdarkly
# APP_FLAGS_SDK_KEY=<secret>
# APP_FLAGS_VALUES={"users-list":true}
# APP_TELEMETRY_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# New Relic (US); use the regional endpoint for your account:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net
# OTEL_EXPORTER_OTLP_HEADERS=api-key=<license-key>
# OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta

# Independent positive budgets (Go duration syntax):
APP_SHUTDOWN_DRAIN_TIMEOUT=10s
APP_SHUTDOWN_CLEANUP_TIMEOUT=5s
APP_SHUTDOWN_TELEMETRY_TIMEOUT=5s
APP_DATABASE_MIGRATION_TIMEOUT=30s
# Deployments: set APP_ENV=production (or a custom deployment label), use postgres,
# supply APP_DATABASE_DSN and private authentication. Deployment YAML is ignored.
